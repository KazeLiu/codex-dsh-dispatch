{
  "name": "dsh-mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "把 DSH 会话能力以 Streamable HTTP MCP 服务暴露给 Codex 等 MCP 客户端的 DSH 插件",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-mcp-bridge": "./bin/dsh-mcp-bridge.mjs"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "!lib/**/*.map",
    "bin",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.9.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "tsc",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "npm run check:boundaries && tsc --noEmit",
    "syntax": "node --experimental-strip-types --check src/index.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-permission-presets": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-permission-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
