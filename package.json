{
  "name": "codex-dsh-dispatch",
  "version": "0.3.2",
  "description": "把 DSH 会话能力以 Streamable HTTP MCP 服务暴露给 Codex 等 MCP 客户端的 DSH 插件",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "codex",
    "mcp",
    "dispatch",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KazeLiu/codex-dsh-dispatch.git"
  },
  "homepage": "https://github.com/KazeLiu/codex-dsh-dispatch#readme",
  "bugs": {
    "url": "https://github.com/KazeLiu/codex-dsh-dispatch/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "codex-dsh-dispatch": "./bin/codex-dsh-dispatch.mjs"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "!lib/**/*.map",
    "bin",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/INSTALL.md",
    "docs/WORKFLOW.md",
    "docs/PUBLISHING.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.9.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:client": "tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "prepare": "npm run build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "npm run check:boundaries && tsc --noEmit && tsc -p tsconfig.client.json",
    "syntax": "node --experimental-strip-types --check src/index.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-permission-presets": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-permission-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "18.3",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
